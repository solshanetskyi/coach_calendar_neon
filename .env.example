# Server Configuration
PORT=8080

# ============================================
# Database Configuration (Required)
# ============================================

# Neon PostgreSQL Database URL
# Get this from your Neon dashboard at https://console.neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/bookings?sslmode=require

# ============================================
# Email Configuration (Optional - Choose ONE)
# ============================================

# Option 1: AWS SES (Recommended for AWS deployments)
# Uncomment these lines to use AWS SES:
# USE_AWS_SES=true
# SMTP_FROM=verified@yourdomain.com
# AWS_REGION=us-east-1

# Requirements for AWS SES:
# 1. Verify sender email in AWS SES Console
# 2. Attach IAM role with SES permissions to your EC2/ECS instance
# 3. Move out of SES sandbox mode for production use

# Option 2: SMTP (For local development or non-AWS hosting)
# Uncomment these lines to use SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# For Gmail:
# 1. Enable 2-factor authentication
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password as SMTP_PASSWORD

# For other SMTP providers:
# - Outlook/Office365: smtp.office365.com:587
# - Yahoo: smtp.mail.yahoo.com:587
# - SendGrid: smtp.sendgrid.net:587
# - Mailgun: smtp.mailgun.org:587

# Note: If no email is configured, the app runs normally but skips sending emails

# ============================================
# Feature Toggles (Optional)
# ============================================

# Enable/disable confirmation emails
# Set to "yes" or "true" to enable sending confirmation emails
# If not set or set to any other value, confirmation emails will not be sent
SEND_CONFIRMATION_EMAIL=yes

# Enable/disable Zoom meeting creation
# Set to "yes" or "true" to enable creating Zoom meetings for bookings
# If not set or set to any other value, Zoom meetings will not be created
CREATE_ZOOM_MEETING=yes

# ============================================
# Google Calendar Integration (Optional)
# ============================================

# Enable Google Calendar integration to automatically block slots
# when there are events on your Google Calendar
# Set to "yes" or "true" to enable
GOOGLE_CALENDAR_ENABLED=no

# Google Calendar ID (usually your email address)
# Find it in Google Calendar Settings > Integrate calendar
GOOGLE_CALENDAR_ID=your-email@gmail.com

# Service Account Credentials (choose one method):

# Option 1: Path to service account JSON file (for local development)
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Option 2: Service account JSON content (for cloud deployments)
# Paste the entire JSON content as a single line
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Setup Instructions:
# 1. Go to Google Cloud Console: https://console.cloud.google.com
# 2. Create a new project (or select existing)
# 3. Enable the Google Calendar API
# 4. Create a Service Account:
#    - Go to IAM & Admin > Service Accounts
#    - Create Service Account
#    - Download the JSON key file
# 5. Share your Google Calendar with the service account:
#    - Open Google Calendar
#    - Click the 3 dots next to your calendar > Settings
#    - Scroll to "Share with specific people"
#    - Add the service account email (ends with @xxx.iam.gserviceaccount.com)
#    - Give it "See all event details" permission
